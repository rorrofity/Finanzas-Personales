# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finanzas_personales
DB_USER=your_username
DB_PASSWORD=your_password

# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key

# Google OAuth Configuration
# Obtén estos valores desde Google Cloud Console
# Ver documentación en GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Debe coincidir con REACT_APP_GOOGLE_CLIENT_ID del frontend.
# Activar una versión privada nueva invalida las sesiones anteriores.
AUTH_SESSION_VERSION=
APP_PUBLIC_URL=https://finanzas.rocketflow.cl

# External Services
BANK_API_URL=https://example.bank.com/api
BANK_API_KEY=your_bank_api_key

# N8N Configuration
# URL del webhook de N8N para sincronización de emails
# Producción: http://localhost:5678/webhook/sync-bank-emails (mismo servidor)
# Desarrollo y tests: usar una instancia de pruebas sin cuentas bancarias reales.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sync-bank-emails
# Canal privado compartido entre backend, webhook N8N, callback y mapping.
# Generar/configurar solo en servidor y en credencial headerAuth de N8N.
N8N_SYNC_SECRET=
# Cuenta que posee la conexión bancaria; no se puede usar desde otro espacio propio.
# Fallback: CARD_STATEMENTS_OWNER_USER_ID o FINTOC_OWNER_USER_ID.
N8N_SYNC_OWNER_USER_ID=

# Environment
NODE_ENV=development

# Sincronización programada (Epic 13)
# Zona horaria del scheduler (node-cron). Formato cron: "MIN HORA * * *"
TZ=America/Santiago
# 17 ejecuciones: 08:00–23:00 y 00:00. La coma separa expresiones completas.
SYNC_CRON_TIMES=0 8-23 * * *,0 0 * * *
# El scheduler solo corre en NODE_ENV=production salvo que actives esto:
ENABLE_SCHEDULER=false

# Web Push / VAPID (Epic 13)
# Generar con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# NUNCA commitear las claves reales; usar un par distinto por ambiente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@example.com

# Fintoc — consulta privada de la cuenta propia (Epic 17)
# Valores de ejemplo comentados: no habilitan tráfico ni guardan credenciales.
# Configurar únicamente en el .env privado del servidor; nunca REACT_APP_*.
# Ver docs/implementation/fintoc-readonly-activation.md.
# FINTOC_ENABLED=false
# FINTOC_PERSONAL_FREE_ACCESS_CONFIRMED=false
# FINTOC_MODE=test
# FINTOC_OWNER_USER_ID=
# FINTOC_SECRET_KEY=
# FINTOC_LINK_TOKEN=
# FINTOC_ACCOUNT_ID=
# FINTOC_DAILY_SYNC_ENABLED=false
# Ejecución diaria independiente: 07:00 America/Santiago, sin refrescos de pago.

# Optional local reconciliation of bank card statement PDF attachments.
# Secrets are configured privately on the server; never put values in this file.
# CARD_STATEMENTS_OWNER_USER_ID=
# CARD_STATEMENTS_INGEST_SECRET=
# CARD_STATEMENTS_PDF_PASSWORD=
# CARD_STATEMENTS_PYTHON=/opt/finanzas-card-statements-venv/bin/python

# CSN: enable only after migration 034 and reviewed preview. Never updates existing expenses.
# CARD_STATEMENTS_AUTO_POST=false
